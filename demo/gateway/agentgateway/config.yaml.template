# yaml-language-server: $schema=https://agentgateway.dev/schema/config
#
# agentgateway in front of the rig's MCP resource (spire-workload's rs-accounts). It IS the resource as far as anyone
# outside can tell: it listens at the resource's identifier, https://host.docker.internal:8446, with the rig's
# certificate, and rs-accounts moves behind it.
#
#   /.well-known/*   the resource's Entity Configuration and protected resource metadata, passed through untouched
#   /mcp/*           extAuthz to coaz-pep before anything reaches the resource: the token's signature against
#                    PingFederate's JWKS, its issuer, audience and lifetime (coaz-pep verify.go); then, for tools/call,
#                    the tool's x-coaz-mapping -> an AuthZEN evaluation at PingAuthorize. Deny -> JSON-RPC -32401,
#                    a bad token -> 401, the PEP or PDP unreachable -> refused (fail closed).
#
# Not agentgateway's own jwtAuth: once it has verified a token it removes the Authorization header, so neither the
# PEP nor the resource (which makes its own checks too) would see it.
#
# __PLACEHOLDERS__ are filled in by docker-entrypoint.sh from the environment.

binds:
- port: 8446
  listeners:
  - name: rs-accounts
    protocol: HTTPS
    tls:
      cert: /tls/tls.crt
      key: /tls/tls.key
    routes:
    - name: federation-documents
      matches:
      - path:
          pathPrefix: /.well-known/
      backends:
      - host: __RESOURCE_HOST__

    - name: mcp
      matches:
      - path:
          pathPrefix: /mcp
      policies:
        extAuthz:
          host: __EXTAUTHZ_HOST__
          failureMode: deny
          includeRequestBody:
            # the PEP reads the JSON-RPC body: the tool and its arguments
            maxRequestBytes: 65536
            allowPartialMessage: true
          protocol:
            grpc:
              context:
                pep_label: "PEP (rs-accounts MCP)"
                style: "mcp"
                require_token: "true"
                # Tokens are bound to the agent instance's key (cnf.jkt, from the attestation): every call carries
                # a DPoP proof from that key, checked here (coaz-pep dpop.go) - never at the resource.
                require_dpop: "true"
                dpop_htu_base: "__RESOURCE_ID__"
                # The agent acts as itself (client_credentials): there is no end user behind it.
                require_user_login: "false"
                # The PEP has verified the audience (TOKEN_AUDIENCE). Until the rig has its own policy, the PDP runs
                # the borrowed banking package, which pins its own demo's audience - so it isn't sent.
                omit_token_aud: "true"
                # Where the PEP reads tools/list for each tool's x-coaz-mapping.
                mcp_upstream_url: "http://__RESOURCE_HOST__/mcp/v1"
      backends:
      - host: __RESOURCE_HOST__
