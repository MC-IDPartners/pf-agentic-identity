# Kong as the agents' edge, at https://host.docker.internal:8443 (../README.md, "Agents calling agents"). There is no
# agent provider: each sub-agent serves its own identity, <origin>/agent/<name>, and its MCP under it (Raidiam joins
# its client and resource roles by that one identifier), so one origin carries:
#
#   /agent/<name>/.well-known/*  the agent's Entity Configuration and protected resource metadata, served by itself
#   /agent/<name>/mcp*           the agent's MCP, through coaz-pep (token for this agent, DPoP, signals, the PDP)
#   /cb                          the marketplace (control centre): the redirect URI registered on its Raidiam directory
#                                client is https://localhost:8443/cb, so an operator's sign-in comes back through here
#
# Principal agents are hosted by Raidiam, not here.
_format_version: "3.0"

services:
- name: marketplace-sign-in
  url: __MARKETPLACE_URL__
  routes:
  - name: marketplace-sign-in
    paths: ["~/cb$"]
    strip_path: false

- name: accounts-agent
  url: __ACCOUNTS_AGENT_URL__
  routes:
  - name: accounts-agent-identity
    paths: [/agent/accounts-agent/.well-known/]
    strip_path: false
  - name: accounts-agent-mcp
    paths: [/agent/accounts-agent/mcp]
    strip_path: false
    plugins:
    - name: coaz-pep
      config:
        coaz_url: __COAZ_URL__
        route_config:
          pep_label: "PEP (Accounts agent)"
          style: "mcp"
          require_token: "true"
          require_dpop: "true"
          dpop_htu_base: "__PROVIDER_ID__"
          token_audience: "__PROVIDER_ID__/agent/accounts-agent"
          require_user_login: "false"
          omit_token_aud: "true"
          mcp_upstream_url: "__ACCOUNTS_AGENT_URL__/agent/accounts-agent/mcp/v1"

- name: payments-agent
  url: __PAYMENTS_AGENT_URL__
  routes:
  - name: payments-agent-identity
    paths: [/agent/payments-agent/.well-known/]
    strip_path: false
  - name: payments-agent-mcp
    paths: [/agent/payments-agent/mcp]
    strip_path: false
    plugins:
    - name: coaz-pep
      config:
        coaz_url: __COAZ_URL__
        route_config:
          pep_label: "PEP (Payments agent)"
          style: "mcp"
          require_token: "true"
          require_dpop: "true"
          dpop_htu_base: "__PROVIDER_ID__"
          token_audience: "__PROVIDER_ID__/agent/payments-agent"
          require_user_login: "false"
          omit_token_aud: "true"
          mcp_upstream_url: "__PAYMENTS_AGENT_URL__/agent/payments-agent/mcp/v1"
