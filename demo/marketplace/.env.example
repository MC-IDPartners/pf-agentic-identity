# Port the marketplace listens on
PORT=3000

# Public participants export. No credentials needed.
DIRECTORY_PARTICIPANTS_URL=https://data.directory.cba.raidiam.io
DIRECTORY_CACHE_MINUTES=60

# ---------------------------------------------------------------------------
# Raidiam Connect
# Leave RAIDIAM_CLIENT_ID unset to run in mock mode: no outbound calls, the
# lifecycle is simulated locally and every step is still written to the log.
# ---------------------------------------------------------------------------
# RAIDIAM_MOCK=false
# RAIDIAM_BASE_URL=https://matls-api.directory.cba.raidiam.io
# RAIDIAM_TOKEN_URL=https://matls-auth.directory.cba.raidiam.io/token
# RAIDIAM_CLIENT_ID=
# RAIDIAM_CLIENT_SECRET=
# RAIDIAM_SCOPE=directory:software

# Mutual TLS, if your tenant requires it. Put the files in ./certs.
# RAIDIAM_CERT_PATH=/certs/client.crt
# RAIDIAM_KEY_PATH=/certs/client.key
# RAIDIAM_CA_PATH=/certs/ca.crt

# Endpoint templates, override only if your tenant differs.
# RAIDIAM_PATH_SOFTWARE_STATEMENTS=/organisations/{orgId}/softwarestatements
# RAIDIAM_PATH_SOFTWARE_STATEMENT=/organisations/{orgId}/softwarestatements/{ssId}
# RAIDIAM_PATH_AUTHORITY_CLAIMS=/organisations/{orgId}/softwarestatements/{ssId}/authorityclaims

# Base used to mint entity ids
ENTITY_ID_BASE=https://marketplace.demo.cba.raidiam.io/agents
