# The running PingFederate's NON-secret environment. up.sh renders it into .context/vars.env with
# the issuer substituted (PF_BASE_URL) and the one generated secret appended; docker-compose.yml
# reads that. A deployment applies the same values as service variables. Secrets - the DevOps
# licence credentials and OIDF_SSF_INTROSPECTION_CLIENT_SECRET - are never in this file.

# Ping Identity's licence agreement, accepted here for this rig: from 0.6.0 the image accepts it for nobody, and its
# entrypoint refuses to start without it.
PING_IDENTITY_ACCEPT_EULA=YES

# PingFederate's plain HTTP runtime listener, on 9080 for anything on this machine that talks plain HTTP to the rig
# (docker-compose.yml publishes it on PF_PORT_HTTP). The image leaves it off; this turns it on, and the entrypoint
# allows that only because OIDF_DEPLOYMENT_PROFILE below is development.
PF_RUN_PF_HTTP_PORT=9080

# ── Deployment profile ──────────────────────────────────────────────────────────────────────────
# development: this is a rig. It is what lets the image's entrypoint boot from the plaintext data.zip
# compose-context.sh stages and open the plain listener above, and what lets the CIBA simulator below run
# at all. production refuses all three - and production is what an unset variable means, and what any
# value but "development" counts as. The entrypoint and plugins/ciba-sim read it from the environment directly until plan
# item PR-1 centralises the profile.
OIDF_DEPLOYMENT_PROFILE=development

# ── Shared Signals transmitter ──────────────────────────────────────────────────────────────────
# The SET `iss`, the base of every endpoint in /.well-known/ssf-configuration, and what the suite's
# `ssf.transmitter.issuer` is compared with - so it is the same origin as terraform's pf_base_url.
OIDF_SSF_ISSUER=https://localhost:9031
# The servlet validates a receiver's token by asking PF (RFC 7662). The default endpoint is
# <issuer>/as/introspect.oauth2, which would mean PF calling itself out through whatever fronts it and
# being handed its own self-signed certificate. Loopback instead; "insecure" then means trusting that
# certificate on loopback, inside the container. This is the container's own 9031 whatever the issuer
# or the host port is - up.sh substitutes the issuer into the OIDF_SSF_ISSUER and OIDF_FEDERATION_*
# lines only, never here. It says localhost and not 127.0.0.1 because the JDK client still checks the
# certificate's name even when told to trust it, and PF's self-signed certificate names localhost.
OIDF_SSF_INTROSPECTION_ENDPOINT=https://localhost:9031/as/introspect.oauth2
OIDF_SSF_INTROSPECTION_INSECURE_TLS=true
OIDF_SSF_INTROSPECTION_CLIENT_ID=conformance-ssf-rs
# The CAEP Interop Profile's model of a stream (§2.4.4): every subject is in it without an add-subject.
# SSF calls that default_subjects ALL; the servlet advertises it and fans every event out to every
# enabled stream that delivers its type. The default plan passes either way - it only ever adds a
# subject and checks the answer - so this is set for the CAEP plan and costs the other nothing.
OIDF_SSF_DEFAULT_SUBJECTS=ALL
# The scope that lets suite/trigger-caep-events.py raise the three CAEP events the interop plan waits
# for (POST /ssf/events:emit). Held by conformance-ssf-emitter alone; a receiver's token is refused.
OIDF_SSF_PROVISIONER_SCOPE=ssf.provision

# ── Federation and attestation: present, switched off ──────────────────────────────────────────
# The rig runs the whole module set because that is the thing being certified, not a PF with the
# modules taken out. But it belongs to no federation and authenticates no client by attestation, so the
# three components are switched off (plan item S-9; docs/operator/components.md). A component switched off
# never starts: its filters pass every token request to PF's own client authentication, which is what
# the FAPI, SSF and CIBA plans test, and its endpoints answer 404.
#
# Until 0.6.0 the rig kept federation inert by naming itself trust anchor and trust controller with no
# pinned keys, because a module that could not start took pf-runtime.war down. From 0.6.0 that leaves
# AUTO_REGISTRATION enabled and FAILED_CONFIG (no pinned keys) and FEDERATION DEGRADED: ready answers 503
# (F-0192). The federation profiles
# (vars.federation.env) switch the first two back on; nothing here names an anchor.
OIDF_FEDERATION_ENABLED=false
OIDF_AUTO_REGISTRATION_ENABLED=false
OIDF_ATTESTATION_AUTH_ENABLED=false

# ── FAPI 2.0: the two rules PingFederate 13.1 cannot apply per client ───────────────────────────
# A client assertion's aud must be the issuer, as a string; a DPoP proof must be PS256, ES256 or
# EdDSA. PF 13.1.3 accepts RS256 on a proof with no setting to narrow it, and its one audience check
# (Rfc7523bisCompliantAudienceVerification) is for the whole server - and set off in this rig, by
# config-store/, so the SSF suite's client can keep its token-endpoint audience. On 13.0.3 the two were
# four failed modules in the suite's FAPI 2.0 plan. pf-agentic-identity's Fapi2ProfileFilter enforces
# both, for the clients listed here and for nobody else.
#
# A LIST, and not "*", because this rig is the proof of why: the suite's Shared Signals client is an
# ordinary OAuth client that addresses its assertion to the token endpoint, as OIDC Core says to. With
# the rules applied to every client, the SSF plan went from 19 of 19 to 1 of 19.
OIDF_FAPI2_CLIENTS=conformance-fapi2-client1,conformance-fapi2-client2

# FAPI 1.0 Baseline section 6.2.1 at UserInfo - x-fapi-interaction-id set, an access token in the query refused - for
# the FAPI-CIBA plan's clients as well as the two above (from 0.6.0 FapiResourceServerFilter holds only the clients
# these two lists name). Not on the list above: their client assertions address the token endpoint, and the FAPI 2.0
# audience rule would refuse them.
OIDF_FAPI_RESOURCE_CLIENTS=conformance-ciba-client1,conformance-ciba-client2

# ── CIBA simulator ──────────────────────────────────────────────────────────────────────────────
# POST /ciba-sim/decision records allow or deny for an auth_req_id; the ciba-sim OOB authenticator
# answers PingFederate with it. It is an approval oracle keyed by nothing but the auth_req_id, off
# unless this says otherwise, and on here because this is a conformance rig: the suite is the only
# party holding an auth_req_id. It also needs OIDF_DEPLOYMENT_PROFILE=development, above. The
# directory is where the servlet (in the war) and the plugin (a loose jar) meet - two classloaders,
# one filesystem - and both check before every request that it exists, is no symlink, is owned by
# PingFederate's user and is 0700; the image makes it so under the conformance profile.
OIDF_CIBA_SIM_ENABLED=true
OIDF_CIBA_SIM_DIR=/opt/ciba-sim
