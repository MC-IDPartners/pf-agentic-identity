# The raidiam profile (PF_PROFILE=raidiam ./up.sh): PingFederate as an OP in Raidiam's CBA federation, with SPIFFE
# client attestation, for demo/spire-workload's three flows (raidiam/README.md):
#
#   attestation            a SPIRE JWT-SVID -> PF's attester -> attest_jwt_client_auth at the token endpoint
#   federation             private_key_jwt with the workload's trust chain in its trust_chain header; PF validates
#                          the chain it is handed and registers the client automatically (OIDFED 12.1)
#   federation-discovery   the workload's Entity Configuration alone at /federation/register; PF resolves the chain
#                          itself from authority_hints (OIDFED 12.2), then private_key_jwt with no chain. (0.7.0's
#                          token endpoint registers a client it has never seen only from a presented chain.)
#
# up.sh appends this after vars.env (docker compose keeps a name's last value), so it switches federation,
# automatic registration and attestation back on. A development profile: OIDF_DEPLOYMENT_PROFILE=development
# (vars.env) is what lets the mock attester below be trusted at all.

# ── Raidiam's CBA federation ────────────────────────────────────────────────────────────────────
OIDF_FEDERATION_ENABLED=true
OIDF_AUTO_REGISTRATION_ENABLED=true
# PingFederate's superior (its authority_hints) and the anchor every client's chain must end at.
OIDF_FEDERATION_TRUST_ANCHORS=https://federation.directory.cba.raidiam.io/federation_entity/ff726945-ebd7-45e2-9869-c11227669433
OIDF_FEDERATION_TRUST_CONTROLLER_HOST=https://federation.directory.cba.raidiam.io/federation_entity/ff726945-ebd7-45e2-9869-c11227669433
# The anchor's public key, pinned. Pinning is the point: a chain is trusted because it ends at this key, not at
# whatever the anchor's URL serves today. When Raidiam rotates it, update this from
# <anchor>/.well-known/openid-federation (its jwks), checked out of band. As of 2026-10-16: kid mrk-ba02...d603.
OIDF_FEDERATION_TRUST_ANCHOR_JWKS={"keys":[{"alg":"PS256","e":"AQAB","kid":"mrk-ba024780636c4e1ea6e6d77d4b4cd603","kty":"RSA","n":"rr1AgHNRQrMiyc2CnxoGSjC4KHt2OFz7okNmZ6qBfSHkKQ1dODAWkDSjNCYDy4Gzm0epeoxXc7b6-mbGV-Nb9i_rYIR0AHuwHeFVin5Hb0SeIKjxyMGTNRfMwZHx5Sb856W7nKueCssgELbaghSaf1nTFK3-zNk0OSquTiRGlslSiKjvngqqfQ8Eop-XSKZdJmbGqVQBbwqKWW0sdRuMNrX9HwQXsRs0o6FJ3FUB2LjOaZAokPEvZx6z8JP0zzX4CWIJzduX5Su0RYGH-uQMcs9CFy-pj8PjSTHy-kyMZVi-BscZHkKxeUB1rXw6XrYi41eAQjQpeG3gz4WBpNdxOw"}]}
OIDF_FEDERATION_ORGANIZATION_NAME=pf-agentic-identity raidiam rig

# ── SPIFFE client attestation ───────────────────────────────────────────────────────────────────
# The attestation client (terraform/attestation.tf) is authored only when up.sh is given SPIRE_BUNDLE_FILE.
OIDF_ATTESTATION_AUTH_ENABLED=true
# The bridge: per attested client, the key the token-endpoint filter signs PingFederate's private_key_jwt with.
# Inline JWKs from a file (config) - development only; production keeps them in OpenBao (vault).
OIDF_BRIDGE_SIGNER_BACKING=config
OIDF_BRIDGE_SIGNING_KEYS=/opt/pf-raidiam/bridge-signing-keys.json
